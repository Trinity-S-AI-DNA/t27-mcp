test oracle_fold_all_ops_mixed_signs {
    reset();
    set(0, 5);
    set(1, -8);
    set(2, 3);
    set(3, 12);
    set(4, -20);
    set(5, 7);
    assert_eq(fold(Op.Add, 6), -1);
    assert_eq(fold(Op.Max, 6), 12);
    assert_eq(fold(Op.Min, 6), -20);
    assert_eq(fold(Op.AltSum, 6), 5 + 8 + 3 - 12 - 20 - 7);
    assert_eq(fold(Op.AltSum, 4), 5 + 8 + 3 - 12);
    assert_eq(fold(Op.AltSum, 1), 5);
}
test oracle_fold_prefix_only {
    reset();
    set(0, -4);
    set(1, -6);
    set(2, 1000);
    assert_eq(fold(Op.Max, 2), -4);
    assert_eq(fold(Op.Min, 2), -6);
    assert_eq(fold(Op.Add, 2), -10);
    assert_eq(fold(Op.Max, 3), 1000);
    assert_eq(fold(Op.Min, 1), -4);
}
test oracle_fold_empty_and_all_negative {
    reset();
    set(0, -3);
    set(1, -9);
    set(2, -1);
    assert_eq(fold(Op.Max, 0), 0);
    assert_eq(fold(Op.Min, 0), 0);
    assert_eq(fold(Op.AltSum, 0), 0);
    assert_eq(fold(Op.Max, 3), -1);
    assert_eq(fold(Op.Min, 3), -9);
    assert_eq(fold(Op.AltSum, 3), -3 + 9 - 1);
}
test oracle_fold_argmax_ties_and_prefix {
    reset();
    set(0, 2);
    set(1, 9);
    set(2, 9);
    set(3, -1);
    set(4, 30);
    assert_eq(argmax(0), 0);
    assert_eq(argmax(1), 0);
    assert_eq(argmax(2), 1);
    assert_eq(argmax(4), 1);
    assert_eq(argmax(5), 4);
    reset();
    set(0, -5);
    set(1, -2);
    assert_eq(argmax(2), 1);
    assert_eq(argmax(6), 2);
}
