module BenchFold;

pub enum Op {
    Add,
    Max,
    Min,
    AltSum,
}

var v : [6]i16 = [0, 0, 0, 0, 0, 0]

fn reset() {
    var i : u8 = 0;
    while (i < 6) {
        v[i] = 0;
        i = i + 1;
    }
}

fn set(i: u8, x: i16) {
    v[i] = x;
}

fn fold(op: Op, n: u8) -> i16 {
    if (n == 0) {
        return 0;
    }
    var acc : i16 = v[0];
    var i : u8 = 1;
    while (i < n) {
        let x : i16 = v[i];
        acc = switch (op) {
            .Add => acc + x,
            .Max => if (x > acc) { x } else { acc },
            .Min => if (x < acc) { x } else { acc },
            .AltSum => if ((i & 1) == 0) { acc + x } else { acc - x },
        };
        i = i + 1;
    }
    return acc;
}

fn argmax(n: u8) -> u8 {
    if (n == 0) {
        return 0;
    }
    var best : u8 = 0;
    var i : u8 = 1;
    while (i < n) {
        if (v[i] > v[best]) {
            best = i;
        }
        i = i + 1;
    }
    return best;
}

test sum_and_max {
    reset();
    set(0, 4);
    set(1, -9);
    set(2, 6);
    assert_eq(fold(Op.Add, 3), 1);
    assert_eq(fold(Op.Max, 3), 6);
}
test empty_is_zero {
    reset();
    set(0, 5);
    assert_eq(fold(Op.Add, 0), 0);
    assert_eq(argmax(0), 0);
}
