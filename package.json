{
  "name": "t27-mcp",
  "version": "1.1.0",
  "description": "MCP server over the live T27 surfaces: the published .t27 spec corpus, the queen feeds, and the numeric-format SSOT.",
  "type": "module",
  "bin": { "t27-mcp": "./server.mjs" },
  "main": "server.mjs",
  "files": ["server.mjs", "graph.mjs", "check.mjs", "examples.mjs", "brief.mjs", "find.mjs", "dashboard.mjs", "telegram.mjs", "deck-view.mjs", "wasm/explorer.wasm", "wasm/check_hints.wasm", "wasm/check_hints.mjs", "wasm/examples.wasm", "wasm/examples_table.mjs", "wasm/paper_claims.wasm", "wasm/paper_claims_table.mjs", "wasm/spec_brief.wasm", "wasm/spec_brief.mjs", "wasm/find.wasm", "wasm/find_table.mjs", "wasm/dashboard.wasm", "wasm/dashboard_table.mjs", "wasm/telegram.wasm", "wasm/telegram_table.mjs", "wasm/t27f.wasm", "wasm/t27f.build", "wasm/hot.wasm", "wasm/hot.mjs", "wasm/spec_graph_view.mjs", "wasm/spec_graph_export.mjs", "wasm/spec_graph_outline.mjs", "wasm/reel.mjs", "wasm/deck.mjs", "README.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node server.mjs",
    "smoke": "node smoke.mjs",
    "check:t27f": "cd wasm && grep -v '^#' t27f.build | shasum -a 256 -c -"
  },
  "license": "Apache-2.0",
  "private": true
}
